# Copy to config.env and fill in your values
# cp config.example.env config.env

# --- YouTube API (Google Cloud Console) ---
# Enable "YouTube Data API v3", create OAuth 2.0 Desktop credentials
YOUTUBE_CLIENT_SECRETS=client_secrets.json

# Channel defaults (shown in every description)
CHANNEL_NAME=ProGamer
CHANNEL_URL=https://youtube.com/@ProGamer-ys7hu
DISCORD_URL=
TWITTER_URL=
TWITCH_URL=

# Default game if not detected from filename (e.g. fortnite, valorant, cod)
DEFAULT_GAME=Gaming

# Upload behavior: public | unlisted | private
DEFAULT_PRIVACY=unlisted

# Review metadata JSON before upload (recommended until you trust the pipeline)
REQUIRE_REVIEW=true

# Optional: OpenAI for smarter titles/descriptions (leave empty to use built-in SEO)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Claude (Anthropic) — scripts & SEO
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
AI_PROVIDER=auto

# Thumbnail style: neon | fire | ice | minimal
THUMBNAIL_STYLE=neon

# Hashtags appended to description (max ~15 for YouTube)
DEFAULT_HASHTAGS=#ProGamer #progamer #gaming #gameplay #gamingchannel

# Playlist ID to add every upload (create in YouTube Studio, copy ID from URL)
DEFAULT_PLAYLIST_ID=

# Language for metadata
DEFAULT_LANGUAGE=en

# Voice — Andrew locked on every long + Short. edge=free | openai=best (OPENAI_API_KEY)
TTS_PROVIDER=edge
TTS_VOICE=en-US-AndrewMultilingualNeural
TTS_RATE=+5%
TTS_PITCH=+0Hz
TTS_VOLUME=+0%
TTS_CHUNK_SENTENCES=true
TTS_AUDIO_POLISH=true
TTS_OPENAI_MODEL=tts-1-hd
TTS_OPENAI_SPEED=1.08
AUTO_PROCESS_AFTER_CREATE=true

# Official trailer clips (yt-dlp + ffmpeg) — real game footage
USE_TRAILER_CLIPS=true
TRAILER_FOOTAGE_STYLE=gameplay
GAMEPLAY_POOL_SIZE=2
# Real gameplay: export once with ./export_youtube_cookies.sh (re-export every ~3 weeks)
YT_DLP_COOKIES_FROM_BROWSER=
YT_DLP_COOKIES_FILE=youtube_cookies.txt
GAME_FOOTAGE_FALLBACK=true
VIDEO_ENCODE_QUALITY=high
YT_MAX_HEIGHT=1080
# Long-form only — 1440 (2560×1440) or 2160 (4K). Shorts stay 1080×1920.
VIDEO_LONG_HEIGHT=1440
YT_MAX_HEIGHT_LONG=1440
YT_MAX_FILESIZE_LONG=800M
# Shorts: only real video clips (trailers/stock), never slideshow stills
SHORTS_VIDEO_ONLY=true
# fit = show full trailer (recommended). fill = zoom crop to edges
SHORTS_ASPECT_MODE=fit

# Pexels stock B-roll — https://www.pexels.com/api/ (generic news only)
PEXELS_API_KEY=
PIXABAY_API_KEY=
COVERR_API_KEY=
RAWG_API_KEY=
USE_STOCK_FOOTAGE=false

# AI scene images (same OPENAI_API_KEY as scripts)
USE_AI_IMAGES=true
OPENAI_IMAGE_MODEL=dall-e-3

# vidIQ MCP — YouTube keywords, trends, competitor/outlier research
# Get key: https://vidiq.com/mcp/ → Connect → API key (or OAuth in Cursor UI)
# Export before Cursor/Grok sessions: export VIDIQ_MCP_API_KEY=your_key_here
VIDIQ_MCP_API_KEY=

# Fresh trending topics (Reddit + Google News; skip repeats for 14 days)
TREND_HISTORY_DAYS=14
TREND_TRACK_HISTORY=true

# Focus mode: one platform + game pool (VidIQ-style niche)
CHANNEL_FOCUS_ENABLED=false
CHANNEL_FOCUS_PLATFORM=PC
CHANNEL_FOCUS_GAMES=Call of Duty,Fortnite,GTA

DAILY_LONG_VIDEOS=1
DAILY_SHORTS=1
AUTO_UPLOAD_DAILY=false
AUTO_CLEANUP_AFTER_UPLOAD=true
UPLOAD_DELAY_SEC=45