//@version=6
strategy("Trend Swing Strategy [Dayrel]", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=2, initial_capital=10000, pyramiding=0, process_orders_on_close=true, commission_type=strategy.commission.percent, commission_value=0.01, max_labels_count=500, max_lines_count=200)

// ─── Inputs ───────────────────────────────────────────────────────────────────
sw_tf       = input.timeframe("",   "Swing Detection Timeframe (blank = chart)", group="Detection")
sw_len      = input.int(5,    "Swing Length (bars each side)",           minval=2,  maxval=20,  group="Detection")
min_lhs     = input.int(3,    "Min Lower Highs before Long (downtrend)", minval=1,  maxval=10,  group="Detection")
min_hls     = input.int(3,    "Min Higher Lows before Short (uptrend)",  minval=1,  maxval=10,  group="Detection")
rr_target   = input.float(5.0,"Risk:Reward Target",                      minval=1.0, step=0.5,  group="Trade")
risk_pct    = input.float(2.0,"Risk % per Trade",                        minval=0.1, step=0.1,  group="Trade")
sl_buf_pct  = input.float(0.1,"SL Buffer %",                             minval=0.0, step=0.05, group="Trade")
show_labels = input.bool(true, "Show HH/HL/LH/LL labels", group="Display")
show_bg     = input.bool(true, "Show trend background",    group="Display")
wh_secret   = input.string("tradelocker_dayrel_2026", "Webhook Secret", group="Webhook")

// ─── Pivot Detection (with optional HTF filter) ───────────────────────────────
// Only use request.security when user explicitly sets a different timeframe.
// Using it on the same TF causes data alignment issues on some feeds (IC Markets etc.)
htf_high = sw_tf != "" ? request.security(syminfo.tickerid, sw_tf, high, lookahead=barmerge.lookahead_off) : high
htf_low  = sw_tf != "" ? request.security(syminfo.tickerid, sw_tf, low,  lookahead=barmerge.lookahead_off) : low

ph = ta.pivothigh(htf_high, sw_len, sw_len)
pl = ta.pivotlow(htf_low,   sw_len, sw_len)

// ─── ATR for label offset ─────────────────────────────────────────────────────
_atr = ta.atr(14)

// ─── Track Last 3 Swing Highs & Lows ─────────────────────────────────────────
var float sh1 = na
var float sh2 = na
var float sh3 = na
var int   shb1 = na
var int   shb2 = na
var float sl1 = na
var float sl2 = na
var float sl3 = na
var int   slb1 = na
var int   slb2 = na

if not na(ph)
    sh3  := sh2
    sh2  := sh1
    sh1  := ph
    shb2 := shb1
    shb1 := bar_index - sw_len

if not na(pl)
    sl3  := sl2
    sl2  := sl1
    sl1  := pl
    slb2 := slb1
    slb1 := bar_index - sw_len

// ─── Trend Classification ─────────────────────────────────────────────────────
is_hh = not na(sh1) and not na(sh2) and sh1 > sh2
is_lh = not na(sh1) and not na(sh2) and sh1 < sh2
is_hl = not na(sl1) and not na(sl2) and sl1 > sl2
is_ll = not na(sl1) and not na(sl2) and sl1 < sl2

var int trend = 0
if is_hh and is_hl
    trend := 1
else if is_lh and is_ll
    trend := -1

var int hl_count = 0
var int lh_count = 0

if not na(pl)
    if is_hl
        hl_count += 1
    else if is_ll
        hl_count := 0

if not na(ph)
    if is_lh
        lh_count += 1
    else if is_hh
        lh_count := 0

// ─── W Pattern — Long Entry (Reversal from Downtrend) ────────────────────────
// Price making 3+ LH+LL confirms downtrend. W pattern = higher low = first reversal sign.
// Entry: close above neckline (sh1). SL: below the higher low (sl1).
var float w_neck  = na
var float w_hl    = na
var bool  w_armed = false

w_valid = not na(sl1) and not na(sl2) and not na(sh1) and not na(slb1) and not na(slb2) and not na(shb1) and sl1 > sl2 and slb2 < shb1 and shb1 < slb1 and lh_count >= min_lhs

if not na(pl) and w_valid
    w_neck  := sh1
    w_hl    := sl1
    w_armed := true

if w_armed and low < w_hl
    w_armed := false
    w_neck  := na
    w_hl    := na

long_signal = w_armed and close > w_neck and barstate.isconfirmed and strategy.position_size == 0

// ─── M Pattern — Short Entry (Reversal from Uptrend) ─────────────────────────
// Price making 3+ HH+HL confirms uptrend. M pattern = lower high = first reversal sign.
// Entry: close below neckline (sl1). SL: above the lower high (sh1).
var float m_neck  = na
var float m_lh    = na
var bool  m_armed = false

m_valid = not na(sh1) and not na(sh2) and not na(sl1) and not na(shb1) and not na(shb2) and not na(slb1) and sh1 < sh2 and shb2 < slb1 and slb1 < shb1 and hl_count >= min_hls

if not na(ph) and m_valid
    m_neck  := sl1
    m_lh    := sh1
    m_armed := true

if m_armed and high > m_lh
    m_armed := false
    m_neck  := na
    m_lh    := na

short_signal = m_armed and close < m_neck and barstate.isconfirmed and strategy.position_size == 0

// ─── Trade Execution ──────────────────────────────────────────────────────────
var float pos_sl = na
var float pos_tp = na

if long_signal
    entry_px = close
    buf      = w_hl * (sl_buf_pct / 100)
    pos_sl  := w_hl - buf
    pos_tp  := entry_px + rr_target * (entry_px - pos_sl)
    w_armed := false
    w_neck  := na
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", from_entry="Long", stop=pos_sl, limit=pos_tp)
    label.new(bar_index, low - _atr * 0.5, "LONG\n" + str.tostring(entry_px, "#.##") + "\nSL " + str.tostring(pos_sl, "#.##") + "\nTP " + str.tostring(pos_tp, "#.##"), color=color.green, textcolor=color.white, style=label.style_label_up, size=size.small)
    alert('{"secret":"' + wh_secret + '","action":"buy","symbol":"' + syminfo.ticker + '","entry":' + str.tostring(entry_px, "#.##") + ',"sl":' + str.tostring(pos_sl, "#.##") + ',"tp":' + str.tostring(pos_tp, "#.##") + ',"risk_pct":' + str.tostring(risk_pct, "#.##") + '}', alert.freq_once_per_bar_close)

if short_signal
    entry_px = close
    buf      = m_lh * (sl_buf_pct / 100)
    pos_sl  := m_lh + buf
    pos_tp  := entry_px - rr_target * (pos_sl - entry_px)
    m_armed := false
    m_neck  := na
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", from_entry="Short", stop=pos_sl, limit=pos_tp)
    label.new(bar_index, high + _atr * 0.5, "SHORT\n" + str.tostring(entry_px, "#.##") + "\nSL " + str.tostring(pos_sl, "#.##") + "\nTP " + str.tostring(pos_tp, "#.##"), color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)
    alert('{"secret":"' + wh_secret + '","action":"sell","symbol":"' + syminfo.ticker + '","entry":' + str.tostring(entry_px, "#.##") + ',"sl":' + str.tostring(pos_sl, "#.##") + ',"tp":' + str.tostring(pos_tp, "#.##") + ',"risk_pct":' + str.tostring(risk_pct, "#.##") + '}', alert.freq_once_per_bar_close)

// ─── Trailing Stop ────────────────────────────────────────────────────────────
if strategy.position_size > 0 and not na(pl)
    new_sl = pl - pl * (sl_buf_pct / 100)
    if new_sl > pos_sl
        pos_sl := new_sl
        strategy.exit("Long Exit", from_entry="Long", stop=pos_sl, limit=pos_tp)
        label.new(bar_index - sw_len, pl, "Trail " + str.tostring(pos_sl, "#.##"), color=color.new(color.green, 60), textcolor=color.white, style=label.style_label_right, size=size.tiny)

if strategy.position_size < 0 and not na(ph)
    new_sl = ph + ph * (sl_buf_pct / 100)
    if new_sl < pos_sl
        pos_sl := new_sl
        strategy.exit("Short Exit", from_entry="Short", stop=pos_sl, limit=pos_tp)
        label.new(bar_index - sw_len, ph, "Trail " + str.tostring(pos_sl, "#.##"), color=color.new(color.red, 60), textcolor=color.white, style=label.style_label_right, size=size.tiny)

// ─── Trend Reversal Exit ──────────────────────────────────────────────────────
if strategy.position_size > 0 and m_valid and not na(ph)
    strategy.close("Long", comment="M pattern exit")

if strategy.position_size < 0 and w_valid and not na(pl)
    strategy.close("Short", comment="W pattern exit")

// ─── Swing High / Low Lines ───────────────────────────────────────────────────
var line sh_line = na
var line sl_line = na

if not na(ph) and not na(shb1)
    line.delete(sh_line)
    sh_line := line.new(shb1, sh1, bar_index + 100, sh1, color=color.red, width=2, style=line.style_dashed, extend=extend.none)

if not na(pl) and not na(slb1)
    line.delete(sl_line)
    sl_line := line.new(slb1, sl1, bar_index + 100, sl1, color=color.lime, width=2, style=line.style_dashed, extend=extend.none)

// W neckline — blue dotted (armed, waiting for long entry)
var line wn_line = na
if w_armed and not na(w_neck)
    line.delete(wn_line)
    wn_line := line.new(bar_index - sw_len * 2, w_neck, bar_index + 60, w_neck, color=color.new(color.blue, 30), width=1, style=line.style_dotted)
if not w_armed
    line.delete(wn_line)
    wn_line := na

// M neckline — orange dotted (armed, waiting for short entry)
var line mn_line = na
if m_armed and not na(m_neck)
    line.delete(mn_line)
    mn_line := line.new(bar_index - sw_len * 2, m_neck, bar_index + 60, m_neck, color=color.new(color.orange, 30), width=1, style=line.style_dotted)
if not m_armed
    line.delete(mn_line)
    mn_line := na

// Active SL and TP lines
var line sl_active = na
var line tp_active = na
if strategy.position_size != 0 and not na(pos_sl)
    line.delete(sl_active)
    sl_active := line.new(bar_index - 3, pos_sl, bar_index + 60, pos_sl, color=color.red, width=2, style=line.style_solid)
if strategy.position_size != 0 and not na(pos_tp)
    line.delete(tp_active)
    tp_active := line.new(bar_index - 3, pos_tp, bar_index + 60, pos_tp, color=color.teal, width=2, style=line.style_dashed)

// ─── Swing Labels (every pivot, glued to its candle) ─────────────────────────
if show_labels and not na(ph)
    label.new(bar_index - sw_len, ph, is_hh ? "HH" : "LH", color=is_hh ? color.new(color.green, 50) : color.new(color.red, 50), textcolor=color.white, style=label.style_label_down, size=size.small)

if show_labels and not na(pl)
    label.new(bar_index - sw_len, pl, is_hl ? "HL" : "LL", color=is_hl ? color.new(color.green, 50) : color.new(color.red, 50), textcolor=color.white, style=label.style_label_up, size=size.small)

// ─── Trend Background ─────────────────────────────────────────────────────────
bgcolor(show_bg and trend == 1 ? color.new(color.green, 95) : show_bg and trend == -1 ? color.new(color.red, 95) : na, title="Trend Background")

// ─── Dashboard Table ──────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 75), border_color=color.new(color.gray, 50), border_width=1, frame_color=color.gray, frame_width=1)

trend_txt = trend == 1 ? "BULLISH" : trend == -1 ? "BEARISH" : "NEUTRAL"
trend_col = trend == 1 ? color.lime : trend == -1 ? color.red : color.gray
pos_txt = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
pos_col = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray

table.cell(dash, 0, 0, "TREND SWING", text_color=color.white,  text_size=size.small, bgcolor=color.new(color.navy, 40))
table.cell(dash, 1, 0, "[DAYREL]",    text_color=color.silver, text_size=size.small, bgcolor=color.new(color.navy, 40))
table.cell(dash, 0, 1, "Trend",       text_color=color.gray,   text_size=size.tiny)
table.cell(dash, 1, 1, trend_txt,     text_color=trend_col,    text_size=size.small)
table.cell(dash, 0, 2, "Position",    text_color=color.gray,   text_size=size.tiny)
table.cell(dash, 1, 2, pos_txt,       text_color=pos_col,      text_size=size.small)
table.cell(dash, 0, 3, "HL (Short?)", text_color=color.gray,   text_size=size.tiny)
table.cell(dash, 1, 3, str.tostring(hl_count) + " / " + str.tostring(min_hls), text_color=hl_count >= min_hls ? color.red : color.orange, text_size=size.small)
table.cell(dash, 0, 4, "LH (Long?)",  text_color=color.gray,   text_size=size.tiny)
table.cell(dash, 1, 4, str.tostring(lh_count) + " / " + str.tostring(min_lhs), text_color=lh_count >= min_lhs ? color.lime : color.orange, text_size=size.small)
table.cell(dash, 0, 5, "Last SH",     text_color=color.gray,   text_size=size.tiny)
table.cell(dash, 1, 5, na(sh1) ? "n/a" : str.tostring(sh1, "#.##"), text_color=color.red, text_size=size.small)
table.cell(dash, 0, 6, "Last SL",     text_color=color.gray,   text_size=size.tiny)
table.cell(dash, 1, 6, na(sl1) ? "n/a" : str.tostring(sl1, "#.##"), text_color=color.lime, text_size=size.small)
